---
import '@/styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
const {title="donations"}=Astro.props
import { ClientRouter } from 'astro:transitions'
--- 

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Every donation counts. Help us provide food, education, and healthcare to those who need it most. Make a secure online donation and make a difference today.">
		<title>donations | {title}</title>
		<ClientRouter></ClientRouter>
	</head>
	<body>
    <!-- <GetAllDataDonations client:load/> -->
        <div class="flex flex-col gap-3 justify-between h-screen">
			<Header/>
			<slot/>
			<Footer/>
		</div>
	</body>
</html>


<style is:global>
  /* Mendaftarkan Font Montserrat Regular */
  @font-face {
    font-family: 'Montserrat';
    src: url('/fonts/Montserrat-Thin.woff') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  /* Mendaftarkan Font Montserrat Bold */
  @font-face {
    font-family: 'Montserrat';
    src: url('/fonts/Montserrat-ThinItalic.woff') format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }


  @font-face {
    font-family: 'lato';
    src: url('/fonts/Lato-Black.ttf') format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'lato';
    src: url('/fonts/Lato-Bold.ttf') format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  /* Terapkan font ke seluruh website */
  html {
    font-family: 'lato', sans-serif;
  }
</style>
